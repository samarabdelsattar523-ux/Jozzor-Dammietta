<odoo>
 <record id="mail_application_received" model="mail.template">
  <field name="name">Manufacturer Application Received</field><field name="model_id" ref="model_furniture_manufacturer_application"/>
  <field name="subject">Manufacturer application received - {{ object.name }}</field><field name="email_to">{{ object.email }}</field>
  <field name="body_html" type="html"><div><p>Hello <t t-out="object.representative"/>,</p><p>Your application <t t-out="object.name"/> has been received.</p></div></field>
 </record>
 <record id="mail_application_approved" model="mail.template">
  <field name="name">Manufacturer Application Approved</field><field name="model_id" ref="model_furniture_manufacturer_application"/>
  <field name="subject">Your manufacturer application has been approved</field><field name="email_to">{{ object.email }}</field>
  <field name="body_html" type="html"><div><p>Hello <t t-out="object.representative"/>,</p><p>Your application is approved. Your account invitation will arrive separately.</p></div></field>
 </record>
 <record id="mail_application_rejected" model="mail.template">
  <field name="name">Manufacturer Application Rejected</field><field name="model_id" ref="model_furniture_manufacturer_application"/>
  <field name="subject">Update on your manufacturer application</field><field name="email_to">{{ object.email }}</field>
  <field name="body_html" type="html"><div><p>Hello <t t-out="object.representative"/>,</p><p>Your application was not approved.</p><p><t t-out="object.rejection_reason"/></p></div></field>
 </record>
</odoo>
