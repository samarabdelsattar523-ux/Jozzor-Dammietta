<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Workshop sizes (administrator can edit under Configuration) -->
    <record id="workshop_size_small" model="furniture.workshop.size"><field name="name">Small (1-10 workers)</field><field name="sequence">10</field></record>
    <record id="workshop_size_medium" model="furniture.workshop.size"><field name="name">Medium (11-50 workers)</field><field name="sequence">20</field></record>
    <record id="workshop_size_large" model="furniture.workshop.size"><field name="name">Large (51-200 workers)</field><field name="sequence">30</field></record>
    <record id="workshop_size_industrial" model="furniture.workshop.size"><field name="name">Industrial factory (200+ workers)</field><field name="sequence">40</field></record>

    <record id="mtype_workshop" model="furniture.manufacturer.type"><field name="name">Carpentry Workshop</field><field name="sequence">10</field></record>
    <record id="mtype_factory" model="furniture.manufacturer.type"><field name="name">Furniture Factory</field><field name="sequence">20</field></record>
    <record id="mtype_upholstery" model="furniture.manufacturer.type"><field name="name">Upholstery Specialist</field><field name="sequence">30</field></record>

    <!-- Default (single) settings record -->
    <record id="settings_default" model="furniture.marketplace.settings">
        <field name="name">Marketplace Settings</field>
    </record>

    <!-- Service used on quotations generated from custom furniture requests -->
    <record id="product_custom_manufacturing" model="product.template">
        <field name="name">Custom Furniture Manufacturing</field>
        <field name="type">service</field>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
        <field name="list_price">0.0</field>
    </record>

    <!-- Housekeeping: remove abandoned website application drafts -->
    <record id="cron_cleanup_application_drafts" model="ir.cron">
        <field name="name">Furniture Marketplace: clean abandoned application drafts</field>
        <field name="model_id" ref="model_furniture_manufacturer_application"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup_drafts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Website header entries -->
    <record id="website_menu_marketplace" model="website.menu">
        <field name="name">Furniture Marketplace</field>
        <field name="url">/furniture-marketplace</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">21</field>
    </record>
    <record id="website_menu_custom_request" model="website.menu">
        <field name="name">Custom Furniture Request</field>
        <field name="url">/custom-furniture-request</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">22</field>
    </record>
    <record id="website_menu_join_manufacturer" model="website.menu">
        <field name="name">Join as a Manufacturer</field>
        <field name="url">/manufacturer/apply</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">23</field>
    </record>
</odoo>
