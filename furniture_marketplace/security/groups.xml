<odoo>
    <record id="res_groups_privilege_furniture_marketplace" model="res.groups.privilege">
        <field name="name">Furniture Marketplace</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_website"/>
    </record>

    <record id="group_marketplace_manager" model="res.groups">
        <field name="name">Marketplace Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_furniture_marketplace"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Helper group for manufacturer portal users: hidden from the privilege list. -->
    <record id="group_manufacturer_portal" model="res.groups">
        <field name="name">Manufacturer Portal User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
