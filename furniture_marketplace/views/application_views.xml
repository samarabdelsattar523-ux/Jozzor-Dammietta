<odoo>
 <record id="application_list" model="ir.ui.view"><field name="name">furniture.manufacturer.application.list</field><field name="model">furniture.manufacturer.application</field>
  <field name="arch" type="xml"><list><field name="name"/><field name="manufacturer_name"/><field name="email"/><field name="phone"/><field name="submitted_on"/><field name="state"/></list></field></record>
 <record id="application_form" model="ir.ui.view"><field name="name">furniture.manufacturer.application.form</field><field name="model">furniture.manufacturer.application</field>
  <field name="arch" type="xml"><form><header><button name="action_submit" type="object" string="Submit" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Approve" class="oe_highlight" groups="furniture_marketplace.group_marketplace_manager" invisible="state != 'submitted'"/><button name="action_reject" type="object" string="Reject" groups="furniture_marketplace.group_marketplace_manager" invisible="state != 'submitted'"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/></header>
   <sheet><group><group><field name="name"/><field name="manufacturer_name"/><field name="representative"/><field name="email"/><field name="phone"/></group><group><field name="country_id"/><field name="city"/><field name="workshop_size"/><field name="submitted_on"/><field name="manufacturer_id"/></group></group>
   <notebook><page string="Business"><field name="address"/><field name="description"/></page><page string="Catalog"><field name="catalog_file" filename="catalog_filename"/><field name="catalog_filename"/><field name="imported_product_ids" widget="many2many_tags"/></page><page string="Documents"><field name="document_ids" widget="many2many_binary"/></page><page string="Review"><field name="rejection_reason"/><field name="internal_notes"/></page></notebook></sheet><chatter/></form></field></record>
 <record id="action_applications" model="ir.actions.act_window"><field name="name">Manufacturer Applications</field><field name="res_model">furniture.manufacturer.application</field><field name="view_mode">list,form</field></record>
</odoo>
