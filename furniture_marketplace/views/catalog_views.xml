<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catalog_import_form" model="ir.ui.view">
        <field name="name">furniture.catalog.import.form</field>
        <field name="model">furniture.catalog.import</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_import" type="object" string="Import Products" class="btn-primary"
                            invisible="state == 'imported' or not manufacturer_id"
                            groups="furniture_marketplace.group_marketplace_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="manufacturer_id"/>
                            <field name="application_id"/>
                        </group>
                        <group>
                            <field name="datafile" filename="filename"/>
                            <field name="filename" invisible="1"/>
                            <field name="imported_on"/>
                            <field name="line_count"/>
                            <field name="imported_count"/>
                            <field name="error_count"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="sequence"/>
                            <field name="product_name"/>
                            <field name="category"/>
                            <field name="price"/>
                            <field name="quantity"/>
                            <field name="image_ref"/>
                            <field name="import_state" widget="badge"/>
                            <field name="product_id"/>
                            <field name="warning"/>
                            <field name="error_message"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_catalog_import_list" model="ir.ui.view">
        <field name="name">furniture.catalog.import.list</field>
        <field name="model">furniture.catalog.import</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="manufacturer_id"/>
                <field name="application_id"/>
                <field name="line_count"/>
                <field name="state" widget="badge"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>
    <record id="action_catalog_import" model="ir.actions.act_window">
        <field name="name">Catalog Uploads</field>
        <field name="res_model">furniture.catalog.import</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
