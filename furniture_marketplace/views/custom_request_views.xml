<odoo>
 <record id="custom_request_list" model="ir.ui.view"><field name="name">furniture.custom.request.list</field><field name="model">furniture.custom.request</field><field name="arch" type="xml"><list><field name="name"/><field name="title"/><field name="partner_id"/><field name="manufacturer_id"/><field name="request_date"/><field name="state"/></list></field></record>
 <record id="custom_request_form" model="ir.ui.view"><field name="name">furniture.custom.request.form</field><field name="model">furniture.custom.request</field><field name="arch" type="xml"><form><header>
  <button name="action_submit" type="object" string="Submit" invisible="state != 'draft'"/><button name="action_start_review" type="object" string="Start Review" invisible="state != 'submitted'"/><button name="action_accept" type="object" string="Accept" invisible="state != 'review'"/><button name="action_reject" type="object" string="Reject" invisible="state not in ('submitted','review')"/><button name="action_create_quotation" type="object" string="Create Quotation" class="oe_highlight" invisible="state not in ('accepted','quotation')"/><button name="action_confirm_request" type="object" string="Confirm" invisible="state != 'quotation'"/><button name="action_start_production" type="object" string="Start Production" invisible="state != 'confirmed'"/><button name="action_complete" type="object" string="Complete" invisible="state != 'production'"/><field name="state" widget="statusbar"/></header>
  <sheet><group><group><field name="name"/><field name="title"/><field name="partner_id"/><field name="manufacturer_id"/></group><group><field name="request_date"/><field name="sale_order_id"/><field name="reference_image" filename="reference_image_filename"/></group></group><field name="description"/><field name="notes"/><field name="rejection_reason"/></sheet><chatter/></form></field></record>
 <record id="action_custom_requests" model="ir.actions.act_window"><field name="name">Custom Furniture Requests</field><field name="res_model">furniture.custom.request</field><field name="view_mode">list,form</field></record>
</odoo>
