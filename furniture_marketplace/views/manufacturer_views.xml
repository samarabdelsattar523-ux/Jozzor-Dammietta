<odoo>
 <record id="manufacturer_list" model="ir.ui.view"><field name="name">furniture.manufacturer.list</field><field name="model">furniture.manufacturer</field>
  <field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="email"/><field name="phone"/><field name="country_id"/><field name="city"/><field name="user_id"/><field name="active"/></list></field></record>
 <record id="manufacturer_form" model="ir.ui.view"><field name="name">furniture.manufacturer.form</field><field name="model">furniture.manufacturer</field>
  <field name="arch" type="xml"><form><header><button name="action_view_products" type="object" string="Products"/><button name="action_view_requests" type="object" string="Custom Requests"/></header><sheet>
   <div class="oe_button_box" name="button_box"><button name="action_view_products" type="object" class="oe_stat_button" icon="fa-cubes"><field name="product_count" widget="statinfo" string="Products"/></button><button name="action_view_requests" type="object" class="oe_stat_button" icon="fa-list"><field name="request_count" widget="statinfo" string="Requests"/></button></div>
   <group><group><field name="name"/><field name="code"/><field name="partner_id"/><field name="user_id"/><field name="approved"/><field name="active"/></group><group><field name="representative"/><field name="email"/><field name="phone"/><field name="workshop_size"/></group></group><group><field name="address"/><field name="country_id"/><field name="city"/><field name="description"/></group>
   <notebook><page string="Products"><field name="product_ids" readonly="1"/></page><page string="Requests"><field name="request_ids" readonly="1"/></page></notebook>
  </sheet><chatter/></form></field></record>
 <record id="action_manufacturers" model="ir.actions.act_window"><field name="name">Manufacturers</field><field name="res_model">furniture.manufacturer</field><field name="view_mode">list,form</field></record>
</odoo>
