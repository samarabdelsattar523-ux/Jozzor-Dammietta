<odoo>
 <record id="product_template_form_marketplace" model="ir.ui.view"><field name="name">product.template.form.marketplace</field><field name="model">product.template</field><field name="inherit_id" ref="product.product_template_only_form_view"/>
  <field name="arch" type="xml"><xpath expr="//field[@name='categ_id']" position="after"><field name="manufacturer_id"/><field name="marketplace_approval_state" readonly="1"/><field name="marketplace_submitted_by_manufacturer" readonly="1"/></xpath>
   <xpath expr="//sheet" position="before"><header invisible="not manufacturer_id"><button name="action_submit_marketplace_product" type="object" string="Submit for Approval" invisible="not manufacturer_id or marketplace_approval_state == 'pending'"/><button name="action_approve_marketplace_product" type="object" string="Approve Marketplace Product" class="oe_highlight" groups="furniture_marketplace.group_marketplace_manager" invisible="marketplace_approval_state != 'pending'"/><button name="action_reject_marketplace_product" type="object" string="Reject Marketplace Product" groups="furniture_marketplace.group_marketplace_manager" invisible="marketplace_approval_state != 'pending'"/></header></xpath>
   <xpath expr="//sheet" position="inside"><group string="Marketplace Review" groups="furniture_marketplace.group_marketplace_manager"><field name="marketplace_rejection_reason"/></group></xpath>
  </field>
 </record>
</odoo>
