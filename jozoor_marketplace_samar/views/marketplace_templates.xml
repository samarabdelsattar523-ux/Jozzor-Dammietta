<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="landing_page_template" name="Jozoor Damietta Marketplace">
        <t t-call="website.layout">
            <div id="jozoor_wrap" class="jozoor-marketplace-root">
                <!-- Hero Section -->
                <section class="jozoor-hero container py-5">
                    <div class="row align-items-center">
                        <div class="col-lg-6">
                            <span class="badge text-uppercase tracking-wide mb-3 jozoor-badge">
                                The Heart of Egyptian Furniture
                            </span>
                            <h1 class="jozoor-hero-title">
                                Furniture with a <span class="accent-text">story</span> to tell.
                            </h1>
                            <p class="lead text-muted mt-3">
                                Discover beautiful, handcrafted furniture made by the skilled hands of Damietta's independent workshops.
                            </p>
                            <div class="d-flex gap-3 mt-4">
                                <a href="#discover" class="btn btn-primary btn-lg rounded-pill px-4">
                                    Explore the collection
                                </a>
                                <a href="#story" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                                    Why Damietta?
                                </a>
                            </div>
                            <div class="d-flex gap-5 mt-5 pt-4 border-top">
                                <div>
                                    <strong class="h2 d-block text-dark">240+</strong>
                                    <small class="text-muted">Independent makers</small>
                                </div>
                                <div>
                                    <strong class="h2 d-block text-dark">12k+</strong>
                                    <small class="text-muted">Pieces discovered</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 mt-4 mt-lg-0">
                            <div class="jozoor-hero-card rounded-4 overflow-hidden position-relative shadow-sm">
                                <img src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&amp;fit=crop&amp;w=1300&amp;q=90" 
                                     alt="Damietta Interior Furniture" class="img-fluid w-100 object-cover" style="height: 520px;" />
                                <div class="hero-overlay p-4 text-white position-absolute bottom-0 start-0 end-0">
                                    <small class="text-uppercase tracking-wider opacity-75">Featured collection</small>
                                    <h4 class="font-serif mb-0">The Mediterranean Edit</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Product Showcase -->
                <section id="discover" class="jozoor-collection py-5 bg-light border-top border-bottom">
                    <div class="container">
                        <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-3">
                            <div>
                                <span class="badge text-uppercase jozoor-badge">Curated for you</span>
                                <h2 class="font-serif display-6 mt-2">Find your next <span class="accent-text">heirloom.</span></h2>
                            </div>
                            <div class="search-box">
                                <input type="text" id="jozoor_filter_input" class="form-control rounded-pill px-4" placeholder="Search furniture or makers..." />
                            </div>
                        </div>

                        <!-- Product Grid -->
                        <div class="row g-4 mt-2" id="jozoor_product_grid">
                            <t t-foreach="products" t-as="p">
                                <div class="col-12 col-sm-6 col-lg-3 product-item" 
                                     t-att-data-name="p.name" 
                                     t-att-data-maker="p.maker_id.name if p.maker_id else ''">
                                    <div class="card h-100 border-0 rounded-4 overflow-hidden shadow-sm product-card">
                                        <div class="card-img-top position-relative" style="background-color: #f8f7f3;">
                                            <img t-att-src="p.jozoor_image_url or '/jozoor_marketplace/static/src/img/placeholder.jpg'" 
                                                 class="w-100 object-cover" style="height: 280px;" t-att-alt="p.name" />
                                            <span class="badge bg-white text-dark position-absolute bottom-0 start-0 m-3 rounded-pill shadow-sm">
                                                Handcrafted
                                            </span>
                                        </div>
                                        <div class="card-body d-flex flex-column justify-content-between p-3">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <h5 class="card-title font-serif mb-1"><t t-esc="p.name" /></h5>
                                                    <span class="text-accent fw-bold"><t t-esc="p.list_price" /> EGP</span>
                                                </div>
                                                <small class="text-muted" t-if="p.maker_id">
                                                    by <t t-esc="p.maker_id.name" />
                                                </small>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                                <small class="text-success fw-bold">
                                                    <i class="fa fa-check-circle me-1"></i>
                                                    <t t-esc="'In stock' if p.jozoor_availability == 'in_stock' else 'Made to order'" />
                                                </small>
                                                <a t-attf-href="/shop/cart/update?product_template_id=#{p.id}" class="btn btn-sm btn-dark rounded-pill px-3">
                                                    Add to cart
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>

                <!-- Workshop Makers Section -->
                <section id="makers" class="container py-5">
                    <div class="row align-items-center mb-4">
                        <div class="col-lg-4">
                            <span class="badge text-uppercase jozoor-badge">Meet the makers</span>
                            <h2 class="font-serif mt-2">The hands behind the <span class="accent-text">craft.</span></h2>
                            <p class="text-muted mt-3">Every piece has a person, a place, and a tradition behind it. Workshops keeping Damietta's legacy alive.</p>
                        </div>
                        <div class="col-lg-8">
                            <div class="row g-3">
                                <t t-foreach="makers" t-as="m">
                                    <div class="col-md-4">
                                        <div class="card border rounded-4 p-3 text-center h-100 shadow-sm">
                                            <div class="rounded-3 overflow-hidden mb-3" style="height: 140px;">
                                                <img t-att-src="m.image_url or '/jozoor_marketplace/static/src/img/placeholder.jpg'" 
                                                     class="w-100 h-100 object-cover" t-att-alt="m.name" />
                                            </div>
                                            <h6 class="font-serif mb-1"><t t-esc="m.name" /></h6>
                                            <small class="text-muted d-block"><t t-esc="m.location" /></small>
                                            <span class="badge bg-warning-subtle text-dark mt-2">
                                                ★ <t t-esc="m.rating" />
                                            </span>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
