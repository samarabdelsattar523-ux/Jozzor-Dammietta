<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_jozoor_marketplace" model="ir.module.category">
        <field name="name">Jozoor Furniture Marketplace</field>
        <field name="description">Access rights for Furniture Marketplace &amp; Manufacturer Portal</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_jozoor_manufacturer_portal" model="res.groups">
        <field name="name">Manufacturer Portal User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        <field name="comment">Portal access for approved furniture manufacturers and workshops.</field>
    </record>

    <record id="group_jozoor_marketplace_manager" model="res.groups">
        <field name="name">Procurement / Marketplace Manager</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Review manufacturer applications, approve products, and monitor custom requests.</field>
    </record>

    <record id="group_jozoor_platform_admin" model="res.groups">
        <field name="name">Platform Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_jozoor_marketplace_manager')), (4, ref('website.group_website_designer')), (4, ref('stock.group_stock_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full administrative control over Jozoor Marketplace configuration, approvals, and security.</field>
    </record>
</odoo>
