<odoo>
 <record id="rule_manufacturer_profile" model="ir.rule">
  <field name="name">Manufacturer: own profile</field><field name="model_id" ref="model_furniture_manufacturer"/>
  <field name="groups" eval="[(4, ref('group_manufacturer_portal'))]"/>
  <field name="domain_force">[('user_id', '=', user.id)]</field>
 </record>
 <record id="rule_manufacturer_products" model="ir.rule">
  <field name="name">Manufacturer: own products</field><field name="model_id" ref="product.model_product_template"/>
  <field name="groups" eval="[(4, ref('group_manufacturer_portal'))]"/>
  <field name="domain_force">[('manufacturer_id.user_id', '=', user.id)]</field>
 </record>
 <record id="rule_manufacturer_requests" model="ir.rule">
  <field name="name">Manufacturer: assigned requests</field><field name="model_id" ref="model_furniture_custom_request"/>
  <field name="groups" eval="[(4, ref('group_manufacturer_portal'))]"/>
  <field name="domain_force">[('manufacturer_id.user_id', '=', user.id)]</field>
 </record>
 <record id="rule_customer_requests" model="ir.rule">
  <field name="name">Portal customer: own requests</field><field name="model_id" ref="model_furniture_custom_request"/>
  <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
  <field name="domain_force">[('partner_id', 'child_of', user.partner_id.commercial_partner_id.id)]</field>
 </record>
</odoo>
