<odoo>
 <template id="marketplace_home" name="Furniture Marketplace">
  <t t-call="website.layout"><div id="wrap" class="oe_structure"><section class="container py-5">
   <div class="text-center mb-4"><h1>Furniture Marketplace</h1><p>Furniture from approved manufacturers and workshops.</p><a class="btn btn-primary me-2" href="/custom-furniture-request">Custom Furniture Request</a><a class="btn btn-outline-primary" href="/manufacturer/apply">Join as a Manufacturer</a></div>
   <h2>Categories</h2><div class="row"><t t-foreach="categories" t-as="category"><div class="col-6 col-md-3 mb-3"><a class="card h-100" t-att-href="'/shop/category/%s' % slug(category)"><div class="card-body"><h5 t-esc="category.name"/><small><t t-esc="len(category.product_tmpl_ids.filtered(lambda p: p.website_published and p.marketplace_approval_state == 'approved'))"/> products</small></div></a></div></t></div>
   <h2 class="mt-4">Furniture</h2><div class="row"><t t-foreach="products" t-as="product"><div class="col-6 col-md-3 mb-4"><div class="card h-100"><a t-att-href="product.website_url"><img class="card-img-top" t-att-src="'/web/image/product.template/%s/image_512' % product.id" t-att-alt="product.name"/></a><div class="card-body"><h5 t-esc="product.name"/><p t-field="product.list_price"/><small>Manufacturer: <t t-esc="product.manufacturer_id.name"/></small><p class="small">Available: <t t-esc="product.qty_available"/></p><a class="btn btn-sm btn-primary" t-att-href="product.website_url">View Product</a></div></div></div></t></div>
  </section></div></t>
 </template>
 <template id="manufacturer_application_form" name="Manufacturer Registration">
  <t t-call="website.layout"><div class="container py-5"><h1>Join as a Manufacturer</h1><div t-if="error" class="alert alert-danger" t-esc="error"/>
   <form action="/manufacturer/apply" method="post" enctype="multipart/form-data" class="row g-3"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
    <div class="col-md-6"><label>Manufacturer / Workshop Name *</label><input class="form-control" name="manufacturer_name" required="required"/></div><div class="col-md-6"><label>Owner / Representative *</label><input class="form-control" name="representative" required="required"/></div>
    <div class="col-md-6"><label>Email *</label><input class="form-control" type="email" name="email" required="required"/></div><div class="col-md-6"><label>Mobile *</label><input class="form-control" name="phone" required="required"/></div>
    <div class="col-12"><label>Detailed Address *</label><textarea class="form-control" name="address" required="required"/></div>
    <div class="col-md-6"><label>Country *</label><select class="form-select" name="country_id" required="required"><option value="">Select</option><t t-foreach="countries" t-as="c"><option t-att-value="c.id" t-esc="c.name"/></t></select></div><div class="col-md-6"><label>City *</label><input class="form-control" name="city" required="required"/></div>
    <div class="col-md-6"><label>Workshop Size *</label><select class="form-select" name="workshop_size" required="required"><option value="small">Small</option><option value="medium">Medium</option><option value="large">Large</option><option value="enterprise">Enterprise</option></select></div>
    <div class="col-12"><label>Description</label><textarea class="form-control" name="description"/></div><div class="col-md-6"><label>Product Catalog (CSV/XLSX) *</label><input class="form-control" type="file" name="catalog_file" accept=".csv,.xlsx" required="required"/></div><div class="col-md-6"><label>Additional Documents</label><input class="form-control" type="file" name="documents" multiple="multiple"/></div><div class="col-12"><button class="btn btn-primary">Submit Application</button></div>
   </form></div></t>
 </template>
 <template id="application_thanks" name="Application Submitted"><t t-call="website.layout"><div class="container py-5"><h1>Application Submitted</h1><p>Reference: <strong t-esc="application.name"/></p></div></t></template>
 <template id="custom_request_form" name="Custom Furniture Request"><t t-call="website.layout"><div class="container py-5"><h1>Custom Furniture Request</h1><div t-if="error" class="alert alert-danger" t-esc="error"/>
  <form action="/custom-furniture-request" method="post" enctype="multipart/form-data" class="row g-3"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
   <div class="col-md-6"><label>Request Title *</label><input class="form-control" name="title" required="required"/></div><div class="col-md-6"><label>Preferred Manufacturer *</label><select class="form-select" name="manufacturer_id" required="required"><option value="">Select</option><t t-foreach="manufacturers" t-as="m"><option t-att-value="m.id" t-esc="m.name"/></t></select></div>
   <div class="col-12"><label>Furniture Description *</label><textarea class="form-control" name="description" required="required"/></div><div class="col-md-6"><label>Reference Image *</label><input class="form-control" type="file" name="reference_image" accept="image/*" required="required"/></div><div class="col-12"><label>Additional Notes</label><textarea class="form-control" name="notes"/></div><div class="col-12"><button class="btn btn-primary">Submit Request</button></div>
  </form></div></t></template>
 <template id="custom_request_thanks" name="Request Submitted"><t t-call="website.layout"><div class="container py-5"><h1>Request Submitted</h1><p>Reference: <strong t-esc="request_record.name"/></p><a href="/my/furniture-requests">My Requests</a></div></t></template>
 <template id="portal_my_requests" name="My Furniture Requests"><t t-call="portal.portal_layout"><div class="container py-4"><h3>My Custom Furniture Requests</h3><table class="table"><thead><tr><th>Reference</th><th>Title</th><th>Manufacturer</th><th>Status</th></tr></thead><tbody><tr t-foreach="records" t-as="r"><td><a t-att-href="'/my/furniture-requests/%s' % r.id" t-esc="r.name"/></td><td t-esc="r.title"/><td t-esc="r.manufacturer_id.name"/><td t-esc="r.state"/></tr></tbody></table></div></t></template>
 <template id="portal_request_detail" name="Furniture Request Detail"><t t-call="portal.portal_layout"><div class="container py-4"><h3 t-esc="record.title"/><p>Reference: <span t-esc="record.name"/></p><p>Status: <span t-esc="record.state"/></p><p t-esc="record.description"/></div></t></template>
 <template id="manufacturer_dashboard" name="Manufacturer Dashboard"><t t-call="portal.portal_layout"><div class="container py-4"><h2 t-esc="manufacturer.name"/> <div t-if="portal_error" class="alert alert-danger" t-esc="portal_error"/><h4>Add Product</h4><form action="/my/manufacturer/product/create" method="post" class="row g-2 mb-4"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="col-md-4"><input class="form-control" name="name" placeholder="Product name" required="required"/></div><div class="col-md-2"><input class="form-control" name="list_price" type="number" step="0.01" min="0" placeholder="Price" required="required"/></div><div class="col-md-4"><input class="form-control" name="description_sale" placeholder="Short description"/></div><div class="col-md-2"><button class="btn btn-primary">Create Draft</button></div></form><p class="text-muted">New products are created as Pending Approval and are not published until approved by the marketplace team.</p><h4>My Products</h4>
  <table class="table"><thead><tr><th>Product</th><th>Price</th><th>Approval</th><th>Published</th><th/></tr></thead><tbody><tr t-foreach="products" t-as="p"><td t-esc="p.name"/><td t-field="p.list_price"/><td t-esc="p.marketplace_approval_state"/><td t-esc="p.website_published"/><td><form action="/my/manufacturer/product/submit" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="product_id" t-att-value="p.id"/><button class="btn btn-sm btn-primary">Submit for Approval</button></form></td></tr></tbody></table>
  <h4>My Order Items</h4><p class="text-muted">These are order lines assigned to your manufacturer account. The customer places one order and completes one checkout even when the cart contains products from multiple manufacturers.</p><table class="table"><thead><tr><th>Order</th><th>Order Date</th><th>Product</th><th>Quantity</th><th>Line Total</th><th>Order Status</th></tr></thead><tbody><tr t-foreach="order_lines" t-as="line"><td t-esc="line.order_id.name"/><td t-field="line.order_id.date_order"/><td t-esc="line.product_id.display_name"/><td t-field="line.product_uom_qty"/><td t-field="line.price_subtotal"/><td t-esc="line.order_id.state"/></tr></tbody></table>
  <h4>Assigned Custom Requests</h4><table class="table"><thead><tr><th>Reference</th><th>Title</th><th>Customer</th><th>Status</th></tr></thead><tbody><tr t-foreach="custom_requests" t-as="r"><td t-esc="r.name"/><td t-esc="r.title"/><td t-esc="r.partner_id.name"/><td t-esc="r.state"/></tr></tbody></table></div></t></template>
</odoo>
